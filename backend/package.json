{
  "name": "@creator-flow/backend",
  "version": "0.1.0",
  "description": "CreatorFlow backend service",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/db/migrate.ts",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@8.15.9",
  "author": "kabikabi",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.19.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
